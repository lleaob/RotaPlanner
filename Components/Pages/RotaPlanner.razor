@page "/planner"
@using global::RotaPlanner.Models
@using global::RotaPlanner.Services
@inject global::RotaPlanner.Services.RotaEngine Engine
@rendermode InteractiveServer

<PageTitle>Team Rota Planner</PageTitle>

<h3>Team Rota Planner</h3>

<div class="planner-container" style="display: flex; gap: 30px; margin-top: 20px;">
    
    <!-- Left Side: Configuration Controls -->
    <div class="controls-panel" style="flex: 1; max-width: 350px; background: #f8f9fa; padding: 20px; border-radius: 8px;">
        <h4>1. Setup Parameters</h4>
        <div style="margin-bottom: 15px;">
            <label style="display:block; font-weight:bold;">Start Date:</label>
            <input type="date" @bind="selectedStartDate" @bind:after="UpdateSchedule" class="form-control" />
        </div>

        <h4 style="margin-top: 25px;">2. Define Sequence Pattern</h4>
        <p style="font-size: 0.85rem; color: #6c757d;">Build your rotation sequence step-by-step.</p>
        
        <div class="pattern-list" style="margin-bottom: 15px;">
            @for (int i = 0; i < customSequence.Count; i++)
            {
                int index = i; // Capture index for lambda
                PatternBlock block = customSequence[index];
                
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                    <span style="font-weight: 500; min-width: 50px;">Step @(index + 1):</span>
                    
                    <input type="number" min="1" @bind="block.Days" @bind:after="UpdateSchedule" style="width: 60px;" />
                    
                    <select @bind="block.Type" @bind:after="UpdateSchedule" style="padding: 2px;">
                        <option value="On">Days ON</option>
                        <option value="Off">Days OFF</option>
                    </select>

                    <button type="button" @onclick="() => RemovePatternBlock(index)" style="background:none; border:none; color:#dc3545; cursor:pointer;">❌</button>
                </div>
            }
        </div>

        <div style="display:flex; gap:10px; margin-bottom: 25px;">
            <button @onclick='() => AddPatternBlock("On")' class="btn btn-sm" style="background:#d4edda; color:#155724; border:1px solid #c3e6cb;">+ Add Work Block</button>
            <button @onclick='() => AddPatternBlock("Off")' class="btn btn-sm" style="background:#e2e3e5; color:#383d41; border:1px solid #d6d8db;">+ Add Off Block</button>
        </div>

        <h4>3. Shift Start Times</h4>
        <div style="margin-bottom: 15px;">
            <label><input type="checkbox" @bind="useAlternatingTimes" @bind:after="UpdateSchedule" /> Enable 7, 8, 9 AM Rotation</label>
        </div>
    </div>

    <!-- Right Side: Visual Calendar Grid -->
    <div class="calendar-panel" style="flex: 2;">
        <div class="calendar-grid">
            @foreach (string day in Enum.GetNames(typeof(DayOfWeek)))
            {
                <div class="grid-header">@day.Substring(0, 3)</div>
            }

            @for (int i = 0; i < OffsetDays; i++)
            {
                <div class="grid-cell empty"></div>
            }

            @foreach (ShiftDay day in DisplayDays)
            {
                <div class="grid-cell @(day.IsWorkDay ? "work-day" : "off-day")">
                    <span class="day-number">@day.Date.Day</span>
                    @if (day.IsWorkDay && day.StartTime.HasValue)
                    {
                        <span class="shift-time">@day.StartTime.Value.ToString("h tt")</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .form-control { width: 100%; padding: 6px; margin-top: 4px; }
    .btn-sm { padding: 4px 8px; font-size: 0.85rem; border-radius: 4px; cursor: pointer; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; max-width: 600px; }
    .grid-header { font-weight: bold; text-align: center; padding: 5px; }
    .grid-cell { border: 1px solid #ccc; min-height: 70px; padding: 5px; display: flex; flex-direction: column; justify-content: space-between; }
    .empty { background-color: #f9f9f9; border: 1px dashed #eee; }
    .work-day { background-color: #d4edda; color: #155724; border-left: 4px solid #28a745; }
    .off-day { background-color: #e2e3e5; color: #383d41; border-left: 4px solid #6c757d; }
    .shift-time { font-size: 0.75rem; font-weight: bold; background: rgba(255,255,255,0.75); padding: 2px; border-radius: 3px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
</style>

@code {
    private DateTime selectedStartDate { get; set; } = new DateTime(2026, 9, 1);
    private List<ShiftDay> DisplayDays { get; set; } = new();
    private bool useAlternatingTimes { get; set; } = false;

    // Helper UI model to keep track of individual rows easily in Blazor binding
    private class PatternBlock { public int Days { get; set; } = 1; public string Type { get; set; } = "On"; }
    private List<PatternBlock> customSequence = new()
    {
        new PatternBlock { Days = 4, Type = "On" },
        new PatternBlock { Days = 2, Type = "Off" },
        new PatternBlock { Days = 5, Type = "On" },
        new PatternBlock { Days = 2, Type = "Off" }
    };

    private int OffsetDays
    {
        get
        {
            // Figure out the padding days needed to align day 1 to the correct day of the week column
            DateOnly start = DateOnly.FromDateTime(selectedStartDate);
            return (int)start.DayOfWeek;
        }
    }

    protected override void OnInitialized()
    {
        UpdateSchedule();
    }

    private void UpdateSchedule()
    {
        DateOnly start = DateOnly.FromDateTime(selectedStartDate);
        
        // Map UI Pattern Blocks into the primitive list expected by RotaEngine [4, -2, 5, -2]
        List<int> sequenceArray = new();
        foreach (PatternBlock block in customSequence)
        {
            int multiplier = block.Type == "Off" ? -1 : 1;
            sequenceArray.Add(block.Days * multiplier);
        }

        RotaPattern pattern = new() { Sequence = sequenceArray };

        if (useAlternatingTimes)
        {
            pattern.StartTimesPool = new List<int> { 7, 8, 9 };
        }

        // Generate exactly 35 days from the selected anchor date to fill out a standard view
        DisplayDays = Engine.GenerateSchedule(start, pattern, 35);
    }

    private void AddPatternBlock(string type)
    {
        customSequence.Add(new PatternBlock { Days = 2, Type = type });
        UpdateSchedule();
    }

    private void RemovePatternBlock(int index)
    {
        if (customSequence.Count > 1)
        {
            customSequence.RemoveAt(index);
            UpdateSchedule();
        }
    }
}
