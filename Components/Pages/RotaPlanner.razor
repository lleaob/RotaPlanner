@page "/"
@page "/planner"
@using global::RotaPlanner.Models
@using global::RotaPlanner.Services
@inject global::RotaPlanner.Services.RotaEngine Engine
@rendermode InteractiveServer

<PageTitle>Team Rota Planner</PageTitle>

<div class="planner-container">
    
    <!-- Left Side: Configuration Controls (Independent Scroll) -->
    <div class="controls-panel">
        <h4>1. Setup Parameters</h4>
        <div class="form-group">
            <label>Start Date:</label>
            <input type="date" @bind="selectedStartDate" @bind:after="UpdateSchedule" class="form-control" />
        </div>
        <div class="form-group">
            <label>Months to Display:</label>
            <select @bind="monthsToDisplay" @bind:after="UpdateSchedule" class="form-control">
                <option value="1">1 Month</option>
                <option value="2">2 Months</option>
                <option value="3">3 Months</option>
                <option value="6">6 Months</option>
                <option value="12">12 Months</option>
            </select>
        </div>

        <h4 style="margin-top: 25px;">2. Define Sequence Pattern</h4>
        <div class="pattern-list form-group">
            @for (int i = 0; i < customSequence.Count; i++)
            {
                int index = i; 
                PatternBlock block = customSequence[index];
                
                <div class="pattern-row">
                    <span class="pattern-label">Step @(index + 1):</span>
                    <input type="number" min="1" @bind="block.Days" @bind:after="UpdateSchedule" class="pattern-days" />
                    <select @bind="block.Type" @bind:after="UpdateSchedule" class="pattern-type">
                        <option value="On">ON</option>
                        <option value="Off">OFF</option>
                    </select>
                    <button type="button" @onclick="() => RemovePatternBlock(index)" class="btn-remove" title="Remove step">❌</button>
                </div>
            }
        </div>

        <div class="pattern-actions">
            <button @onclick='() => AddPatternBlock("On")' class="btn btn-sm btn-add-work">+ Add Work</button>
            <button @onclick='() => AddPatternBlock("Off")' class="btn btn-sm btn-add-off">+ Add Off</button>
        </div>

        <h4>3. Shift Start Times</h4>
        <div>
            <label><input type="checkbox" @bind="useAlternatingTimes" @bind:after="UpdateSchedule" /> Enable 7, 8, 9 AM Rotation</label>
        </div>
    </div>

    <!-- Right Side: Multiple Monthly Calendar Grids (Independent Scroll) -->
    <div class="calendar-panel">
        @foreach (KeyValuePair<MonthKey, List<ShiftDay>> monthGroup in GroupedMonths)
        {
            string displayTitle = new DateTime(monthGroup.Key.Year, monthGroup.Key.Month, 1).ToString("MMMM yyyy");
            int paddingDays = ((int)new DateOnly(monthGroup.Key.Year, monthGroup.Key.Month, 1).DayOfWeek + 6) % 7;

            <div class="month-container">
                <h4 class="month-title">@displayTitle</h4>
                
                <div class="calendar-grid">
                    <!-- Day Headers -->
                    @foreach (string dayName in _dayHeaders)
                    {
                        <div class="grid-header">@dayName</div>
                    }

                    <!-- Week Padding Days -->
                    @for (int p = 0; p < paddingDays; p++)
                    {
                        <div class="grid-cell empty"></div>
                    }

                    <!-- Month Shift Cells -->
                    @foreach (ShiftDay day in monthGroup.Value)
                    {
                        <div class="grid-cell @(day.IsWorkDay ? "work-day" : "off-day")">
                            <span class="day-number">@day.Date.Day</span>
                            @if (day.IsWorkDay && day.StartTime.HasValue)
                            {
                                <span class="shift-time">@FormatShiftTimeRange(day.StartTime.Value)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] _dayHeaders = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private DateTime selectedStartDate { get; set; } = new DateTime(2026, 9, 1);
    private int monthsToDisplay { get; set; } = 3;
    private bool useAlternatingTimes { get; set; } = false;

    // Structure for grouping dictionary keys
    private record MonthKey(int Year, int Month);
    private Dictionary<MonthKey, List<ShiftDay>> GroupedMonths { get; set; } = new();

    private class PatternBlock { public int Days { get; set; } = 1; public string Type { get; set; } = "On"; }
    private List<PatternBlock> customSequence = new()
    {
        new PatternBlock { Days = 4, Type = "On" },
        new PatternBlock { Days = 2, Type = "Off" },
        new PatternBlock { Days = 5, Type = "On" },
        new PatternBlock { Days = 2, Type = "Off" }
    };

    protected override void OnInitialized()
    {
        UpdateSchedule();
    }

    private void UpdateSchedule()
    {
        DateOnly start = DateOnly.FromDateTime(selectedStartDate);
        
        // 1. Calculate length based on selected boundary months
        DateOnly endMonthDate = start.AddMonths(monthsToDisplay);
        int totalDaysNeeded = endMonthDate.DayNumber - start.DayNumber;

        // 2. Prepare pattern parameters
        List<int> sequenceArray = new();
        foreach (PatternBlock block in customSequence)
        {
            sequenceArray.Add(block.Days * (block.Type == "Off" ? -1 : 1));
        }

        RotaPattern pattern = new() { Sequence = sequenceArray };
        if (useAlternatingTimes)
        {
            pattern.StartTimesPool = new List<int> { 7, 8, 9 };
        }

        // 3. Generate raw engine data
        List<ShiftDay> rawTimeline = Engine.GenerateSchedule(start, pattern, totalDaysNeeded);

        // 4. Transform data into monthly dictionary buckets
        GroupedMonths = rawTimeline
            .GroupBy(d => new MonthKey(d.Date.Year, d.Date.Month))
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void AddPatternBlock(string type)
    {
        customSequence.Add(new PatternBlock { Days = 2, Type = type });
        UpdateSchedule();
    }

    private void RemovePatternBlock(int index)
    {
        if (customSequence.Count > 1)
        {
            customSequence.RemoveAt(index);
            UpdateSchedule();
        }
    }

    private static string FormatShiftTimeRange(TimeOnly startTime, int durationHours = 9)
    {
        TimeOnly endTime = startTime.AddHours(durationHours);
        return $"{startTime:HH} to {endTime:HH}";
    }
}
